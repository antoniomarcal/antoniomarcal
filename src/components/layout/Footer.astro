---
import { menuLinks, siteConfig } from "@/site-config";

const year = new Date().getFullYear();
---

<footer
	class='mt-auto flex w-full flex-col items-center justify-center gap-y-2 border-t border-border pb-6 pt-8 text-center align-top font-sans text-xs text-text-muted sm:flex-row sm:justify-between'
>
	<div class='me-0 sm:me-4'>
		&copy; {siteConfig.author} {year}
	</div>
	<nav
		aria-label='More on this site'
		class='flex gap-x-1 sm:gap-x-0 sm:divide-x sm:divide-border'
	>
		{
			menuLinks.map((link) => (
				<a
					class='px-4 py-2 transition-colors hover:text-accent sm:py-0'
					href={link.path}
				>
					{link.title}
				</a>
			))
		}
	</nav>
</footer>
